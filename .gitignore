target
notes/

# Coordinator/session briefs and review surfaces (contributor-concern;
# machine-local paths — never tracked)
/PROMPT.md
# Live agent-session state that some agent coordination harnesses maintain at
# the checkout root: per-session scratch, never committed.
/SESSION.md
.lavish/

# mise local opt-in environment selector (created by `mise run dev:enable`).
.miserc.toml

# Generated from mise's nightly pin for Dylint, which strips the environment
# before resolving its driver toolchain.
/crates/workflow-dylint/rust-toolchain

# git worktrees parked inside the checkout (siblings live outside the repo)
.claude/worktrees/

# Beads / Dolt files (added by bd init)
.beads/*.jsonl
.beads/dolt-backup.json
.beads/dolt-backup-state.json
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
# bd regenerates .beads/hooks/ per clone and they embed machine-local paths —
# never tracked (publishable-history).
.beads/hooks/

# bv (beads viewer) local config and caches
.bv/

# Agent tool analysis caches — generated by codegraph/aifix/weave for source
# orientation and cached diagnostic replay; never committed.
.aifix/
.codegraph/
.weave/

# Node package install output
node_modules/

# Coverage / mutation run artifacts (machine-local; baselines belong in notes/)
coverage/*
!coverage/
!coverage/floors.toml
/mutants.out/
/mutants.out.old/

# Proptest failure seeds. Proptest's own header recommends checking these in,
# and here the recommendation inverts: the properties that write them are run
# against hand-applied mutants during mutation campaigns, so a seed file left
# behind pins a case that reproduces the MUTANT and no real defect. A genuine
# counterexample belongs in a named fixture, which is a better artifact than a
# seed anyway. Never tracked.
crates/*/proptest-regressions/

# The C++26 compilation host's out-of-source build trees (its toolchain is a
# discovered installation, so a build tree is machine-local by construction).
/runtime/compile-host/build/
/runtime/compile-host/build-*/

# Fuzzing build output + crash artifacts (seed corpora are tracked)
fuzz/target/
fuzz/artifacts/
fuzz/coverage/

# macOS cruft
.DS_Store

.cache
.obsidian
