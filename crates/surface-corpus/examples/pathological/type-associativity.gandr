// Pathological witness: ungrouped type-operator chains must mold cleanly and lower.
// The pre-wyrd-3dn4 non-associative type bands rejected these chains unless
// every tail was parenthesized.

//@ mode: lower-only
//@ expect: lowers

def product_chain : Integer * Unit * Boolean * String;
def product_chain = ret 1;

def sum_chain : Integer + Unit + Boolean + String;
def sum_chain = ret 1;

def lazy_chain : F Integer & F Unit & F Boolean & F String;
def lazy_chain = ret 1;
