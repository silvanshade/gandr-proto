// A cycle closed with `node` lines rather than `feed`. `w` is reachable from
// itself through the wiring, so no boundary term unfolds from the declared
// output port and the declaration table refuses, naming the port.
//
// This is the derivation's own termination guard and NOT the back-edge sweep,
// whose spelling correction -- this cycle has no `feed`; close loops with
// `feed` -- is still owed by the back-edge rung.
sign Loop {
  sort Nat : Type;
  oper f : (a : Nat) --> (b : Nat);
  oper g : (a : Nat) --> (b : Nat);

  rule spin : (data x : Nat) ==> (z : Nat) {
    node : f(w) --> (z);
    node : g(z) --> (w);
  };
}

//@ mode: desc
//@ expect-desc-decline: reaches port
//@ expect-desc-decline: from itself
//@ expect-desc-composites: 0
