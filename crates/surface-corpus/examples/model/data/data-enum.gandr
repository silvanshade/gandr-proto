// A nullary enumeration and an exhaustive match (ADR-80; ADR-54 §3).
//
// `data Color : Type { … }` declares three nullary constructors -- each a
// bare-result generator judgment that builds a value with no fields. A `case`
// over the three arms is exhaustive; the pipeline places the arms by
// constructor tag, so the runtime selects the arm matching the scrutinee's
// constructor.
//
// A bare constructor `Green` in a checking position (`: Color`) builds the
// tagged value directly, no call needed.
data Color : Type {
  Red : Color;
  Green : Color;
  Blue : Color;
}

def rank() -> F Integer {
  case (Green : Color) {
    Red => ret 0,
    Green => ret 1,
    Blue => ret 2
  }
}

rank()

// The harness checks:
//@ expect: clean
//@ expect-def: rank
//@ expect-last-value: 1
