#!/usr/bin/env gandr
// Walkthrough: the project's first production gandr script.
//
// `scripts/agda-deps.gandr` (run by `mise run agda:deps`) vendors the Agda
// standard library. This file is that script, verbatim apart from its prose
// and the harness directives below -- the driver's CLI suite fails if the two
// ever lower to different programs, because they drifted apart once already.
//
// It is written as ONE flat `sh -c` command because the current shell-block
// lowerer accepts flat simple commands only -- the honest MVP surface -- while
// still exercising the full production path: source file -> `gandr <file>` ->
// lowering -> the L machine -> the `Exec::exec` host handler -> a process
// exit status.
//
// Reading it teaches the current shell-block contract:
//   * `#!{ ... }` holds flat commands, `;`-terminated;
//   * each command lowers to a `perform` of the host `Exec` effect;
//   * the command's output is CAPTURED into the reply record, not relayed to
//     the terminal -- a script computes over its command's output, and a
//     caller watching a long clone sees nothing until it finishes;
//   * the reply is an ordinary value, so a script that merely RETURNS it
//     reports success even when its command failed. Bind the reply and hand
//     its `exit_code` to `proc.exit` (26-env-guard-exit) so the calling shell
//     reads the real status: a failed clone leaves git's own 128 here, and
//     left 0 before this line existed;
//   * idempotence lives in the script text itself (the `if [ ! -f ... ]`
//     guard), not in hidden tool state.
//
// This corpus copy is checked for LOWERING only: the real script clones a
// git repository over the network, and corpus tests stay hermetic. Run the
// real one via `mise run agda:deps`.
{
  run vendored <- #!{
sh -c 'set -eu; vendor="$PWD/metatheory/vendor"; mkdir -p "$vendor"; stdlib="$vendor/agda-stdlib"; stdlib_lib="$stdlib/standard-library.agda-lib"; if [ ! -f "$stdlib_lib" ]; then printf "cloning agda-stdlib v2.4 ...\n"; git clone --depth 1 --branch v2.4 https://github.com/agda/agda-stdlib.git "$stdlib"; fi; printf "%s\n" "$stdlib_lib" > "$PWD/metatheory/libraries"; printf "agda deps ready: stdlib v2.4\n"';
};
  proc.exit(vendored.exit_code)
}

// The harness checks:
//@ mode: lower-only
//@ expect: lowers
