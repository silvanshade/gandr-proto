#!/usr/bin/env gandr
// Walkthrough: the project's first production gandr script.
//
// `scripts/agda-deps.gandr` (run by `mise run agda:deps`) vendors the Agda
// standard library. It is written as ONE flat `sh -c` command because the
// current shell-block lowerer accepts flat simple commands only -- the
// honest MVP surface -- while still exercising the full production path:
// source file -> lowering -> `run_program` -> the `Exec::exec` host handler.
//
// Reading it teaches the current shell-block contract:
//   * `#!{ ... }` holds flat commands, `;`-terminated;
//   * each command lowers to a `perform` of the host `Exec` effect;
//   * idempotence lives in the script text itself (the `if [ ! -f ... ]`
//     guard), not in hidden tool state.
//
// This corpus copy is checked for LOWERING only: the real script clones a
// git repository over the network, and corpus tests stay hermetic. Run the
// real one via `mise run agda:deps`.
#!{
sh -c 'set -eu; vendor="$PWD/metatheory/vendor"; mkdir -p "$vendor"; stdlib="$vendor/agda-stdlib"; stdlib_lib="$stdlib/standard-library.agda-lib"; if [ ! -f "$stdlib_lib" ]; then printf "cloning agda-stdlib v2.4 ...\n"; git clone --depth 1 --branch v2.4 https://github.com/agda/agda-stdlib.git "$stdlib"; fi; printf "%s\n" "$stdlib_lib" > "$PWD/metatheory/libraries"; printf "agda deps ready: stdlib v2.4\n"';
}

// The harness checks:
//@ mode: lower-only
//@ expect: lowers
