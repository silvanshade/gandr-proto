// Bicartesian structure over an infinity-graph, as a codata consumer.
//
// A graph here is an object carrier and a hom-graph for every pair. That
// is the shape the coproduct hom family is defined over: one dimension
// down, forever. Large by default. No level annotations.
//
// The gate is a type-valued observation plus Path in type position under
// corecursion. Until those land this file records the consumer, not a
// checked instance.

codata Glob : Type {
  cells : Type;
  hom(x : cells, y : cells) : Glob;
}

def path_glob(A : Type) -> Glob {
  glob {
    cells = A;
    hom(x, y) = path_glob(Path(A, x, y));
  }
}

//@ expect: goal
