// The category of discrete setoids, ascribed to a hand-written Model(CatShape).
//
// An object is a type. A hom is a function. Equality is Path, so the laws
// are checked against setoid equality. Discrete setoids are setoids: the
// carrier is the type, the equality is identity. Large by default. No level
// annotations. Universe is Russell-style.
//
// Two modules, on purpose. SetoidCatLaws is written with landed type
// components so the item closes and the engine reaches the here-based law
// fields. The goal that must check is
// Path((a -> F b), comp(a, a, b, id(a), f), f).
//
// SetoidCat is the honest Model(CatShape) signature, including
// type Hom : Ob -> Ob -> Type. That form currently swallows the rest of
// the file and still binds, so it sits last: the law module stays visible
// and this module is the witness for the silent bind.

module SetoidCatLaws : #{
  type Ob = Type;
  id: (a: Type) -> F (a -> F a);
  comp: (a: Type, b: Type, c: Type, f: (a -> F b), g: (b -> F c)) -> F (a -> F c);
  unitL: (a: Type, b: Type, f: (a -> F b)) -> F(Path((U(a -> F b)), comp(a, a, b, id(a), f), f));
  unitR: (a: Type, b: Type, f: (a -> F b)) -> F(Path((U(a -> F b)), comp(a, b, b, f, id(b)), f));
  assoc: (a: Type, b: Type, c: Type, d: Type, f: (a -> F b), g: (b -> F c), h: (c -> F d)) -> F(Path((U(a -> F d)), comp(a, c, d, comp(a, b, c, f, g), h), comp(a, b, d, f, comp(b, c, d, g, h))));
} {
  def id(a: Type, x: a) -> F a {
    ret x
  }

  def comp(a: Type, b: Type, c: Type, f: U[ω] (a -> F b), g: U[ω] (b -> F c), x: a) -> F c {
    run y <- f(x);
    g(y)
  }

  def unitL(a: Type, b: Type, f: U[ω] (a -> F b)) -> F(Path((U(a -> F b)), thunk { comp(a, a, b, thunk { id(a) }, f) }, f)) {
    ret here(f)
  }

  def unitR(a: Type, b: Type, f: U[ω] (a -> F b)) -> F(Path((U(a -> F b)), thunk { comp(a, b, b, f, thunk { id(b) }) }, f)) {
    ret here(f)
  }

  def assoc(a: Type, b: Type, c: Type, d: Type, f: U[ω] (a -> F b), g: U[ω] (b -> F c), h: U[ω] (c -> F d)) -> F(Path((U(a -> F d)), comp(a, c, d, comp(a, b, c, f, g), h), comp(a, b, d, f, comp(b, c, d, g, h)))) {
    ret here(comp(a, c, d, comp(a, b, c, f, g), h))
  }
}

def marker = 1;
marker

module SetoidCat : #{
  type Ob : Type;
  type Hom : Ob -> Ob -> Type;
  id: (a: Ob) -> F Hom(a, a);
  comp: (a: Ob, b: Ob, c: Ob, f: Hom(a, b), g: Hom(b, c)) -> F Hom(a, c);
  unitL: (a: Ob, b: Ob, f: Hom(a, b)) -> F(Path(Hom(a, b), comp(a, a, b, id(a), f), f));
  unitR: (a: Ob, b: Ob, f: Hom(a, b)) -> F(Path(Hom(a, b), comp(a, b, b, f, id(b)), f));
  assoc: (a: Ob, b: Ob, c: Ob, d: Ob, f: Hom(a, b), g: Hom(b, c), h: Hom(c, d)) -> F(Path(Hom(a, d), comp(a, c, d, comp(a, b, c, f, g), h), comp(a, b, d, f, comp(b, c, d, g, h))));
} {
  type Ob = Type;

  def id(a: Ob, x: a) -> F a {
    ret x
  }

  def comp(a: Ob, b: Ob, c: Ob, f: Hom(a, b), g: Hom(b, c), x: a) -> F c {
    run y <- f(x);
    g(y)
  }

  def unitL(a: Ob, b: Ob, f: Hom(a, b)) -> F(Path(Hom(a, b), comp(a, a, b, id(a), f), f)) {
    ret here(f)
  }

  def unitR(a: Ob, b: Ob, f: Hom(a, b)) -> F(Path(Hom(a, b), comp(a, b, b, f, id(b)), f)) {
    ret here(f)
  }

  def assoc(a: Ob, b: Ob, c: Ob, d: Ob, f: Hom(a, b), g: Hom(b, c), h: Hom(c, d)) -> F(Path(Hom(a, d), comp(a, c, d, comp(a, b, c, f, g), h), comp(a, b, d, f, comp(b, c, d, g, h)))) {
    ret here(comp(a, c, d, comp(a, b, c, f, g), h))
  }
}

// The harness checks. Flagship acceptance is expect: clean once the Path
// composite endpoints parse and here(f) checks, and once type Hom : Ob -> Ob
// -> Type is a real type component. Today the law fields are
// MissingDelimiter goals and the kinded Hom module binds without a decline.
// `expect: goal` still holds, but NOT for the reason it was written: the goal
// today is the kinded `type Hom : Ob -> Ob -> Type` member, not the law fields.
// `unitL` is a checked definition, and `expect-def` says so here rather than
// leaving the corpus silent about the one thing this example exists to show.
//
// The no-unknown half of the claim is carried by the crate test
// `the_left_unit_law_is_checked` until `expect-type-without-unknown` lands on
// main; the corpus claim is deliberately weaker than the full one until then.
//
// The index arguments to `comp` are verified BY HAND against its declaration
// `comp(a, b, c, f: U(a -> F b), g: U(b -> F c), x: a)`, and they have to be:
// a Path's endpoints are converted but NOT typed. The endpoint lowers to a
// suspended spine whose argument types the checker never checks, and the
// indices are erased at reduction -- comp's body is `run y <- f(x); g(y)`,
// which does not depend on a, b, c -- so the conversion succeeds for ANY index
// assignment. Deliberately absurd indices type here. So `unitL` checking is
// evidence about the CONVERSION, never that its statement is well-formed.
//
// The left unit law is comp(a, a, b, id(a), f): id(a) : a -> F a fixes the
// middle index at a. The right is comp(a, b, b, f, id(b)). They are not
// interchangeable and the engine will not tell you which one you wrote.
//
// The two module declarations are NOT expected to bind, and that is a
// measurement rather than a concession. They previously bound an EMPTY record
// -- silently, with every member lost -- and the expectations asserting they
// bound were true of nothing. With the signature members terminated they now
// decline BY NAME, `UnsupportedForm { kind: "module_declaration" }`, so the
// file is blocked at a live gate instead of hiding behind a spelling defect.
// When the declaration form lands, those expectations come back and say
// something.
//@ expect: goal
//@ expect-def: unitL
//@ expect-def: marker
//@ expect-last-value: 1
