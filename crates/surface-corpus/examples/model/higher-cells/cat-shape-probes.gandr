// Isolated probes for the CatShape neighbourhood. Each form is its own
// item so a swallow or a silent Unknown cannot hide behind a sibling.
//
// path_var is honest: variable carrier, variable endpoints.
// path_fun is a carrier bug, not an endpoint bug: the function-type
// carrier becomes Unknown and the endpoints survive as Var(f).
// path_app erases the whole Path to F(Unknown).
// ix_id is honest: a variable data index stays Atom(n).
// ix_ctor is a data-index fact, not a Path-endpoint spelling rule:
// a literal index has nowhere to live because Data stores arguments
// as value types. Ix(1) becomes Ix(Unknown).
//
// Literal Path endpoints already check in identity/here-formation.gandr.

def path_var(a : Type, x : a) -> F Path(a, x, x) {
  ret here(x)
}

def path_fun(f : (Integer -> F Integer)) -> F Path((Integer -> F Integer), f, f) {
  ret here(f)
}

def path_app(n : Integer) -> F Path(Integer, n + 1, n + 1) {
  ret here(n + 1)
}

data Ix(n : Integer) : Type {
  MkIx : Ix(n);
}

def ix_id(n : Integer, w : Ix(n)) -> F Ix(n) {
  ret w
}

def ix_ctor(w : Ix(1)) -> F Ix(1) {
  ret w
}

// path_var and ix_id are honest. path_fun, path_app, and ix_ctor bind
// after the interesting type lowered to Unknown. That is not a check.
//@ expect-def: path_var
//@ expect-def: path_fun
//@ expect-def: path_app
//@ expect-def: ix_id
//@ expect-def: ix_ctor
