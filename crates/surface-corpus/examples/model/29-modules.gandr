// Primitive modules: records with source-ordered, exactly-once member evaluation.
//
// A `module` declaration builds an ordinary record value. The transparent
// record signature explicitly repacks the returned record while every body
// member still evaluates. The shell command member below keeps its `Exec`
// effect, and the lowercase nested module is one source-ordered component.
// Nested user paths such as `Facts.inner.answer` are ordinary record
// projections after the named outer module value is linked.
//
// The surrounding shell-mode file also pins the shared source-ordered linker:
// `seed` is linked before the module, `after` is linked after the module, and
// the final unnamed record is the single run target.
def seed = 40;

module Facts : #{ inner: #{ answer: Integer }, total: Integer } {
  def hidden_reply = #!{ printf 'hidden module member ran\n'; };
  def base = seed + hidden_reply.exit_code + 1;
  module inner : #{ answer: Integer } {
    def hidden = base;
    def answer = base + 1;
  }
  def total = inner.answer + 1;
}

def after = Facts.total + 1;

#{after = after, total = Facts.total}

// The harness checks:
//@ mode: shell
//@ expect-shell-value: #{after = 44, total = 43}
