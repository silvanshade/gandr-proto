// Primitive modules: source-ordered, exactly-once member evaluation.
//
// A `module` declaration has a path, ordered value components, and nested
// modules that are modules in the same sense. What it *runs* is bind
// sequencing and a terminal record, because the core carries no module former,
// and that is what makes the evaluation order below observable: every body
// member evaluates once, in source order, including the ones the signature
// does not export. The shell command member keeps its `Exec` effect, and the
// nested module is one source-ordered component. A path such as
// `Facts.inner.answer` is resolved through the module stratum and reaches the
// nested component after the named outer module is linked.
//
// The surrounding shell-mode file also pins the shared source-ordered linker:
// `seed` is linked before the module, `after` is linked after the module, and
// the final unnamed record is the single run target.
def seed = 40;

module Facts : #{ inner: #{ answer: Integer }, total: Integer } {
  def hidden_reply = #!{ printf 'hidden module member ran\n'; };
  def base = seed + hidden_reply.exit_code + 1;
  module inner : #{ answer: Integer } {
    def hidden = base;
    def answer = base + 1;
  }
  def total = inner.answer + 1;
}

def after = Facts.total + 1;

#{after = after, total = Facts.total}

// The harness checks:
//@ mode: shell
//@ expect-shell-value: #{after = 44, total = 43}
