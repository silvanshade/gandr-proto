// W4d surface fold-in — reserved `data` operation and 2-cell members
// (parse-only fixture).
//
// The operation and rule members ride the nested generator block unchanged:
// `oper` operations and `rule` rewrites graduate under their own rungs. The
// signature unification respelled the operation member from `op` to `oper`
// (`op` is the operator-fixity declaration only), and the retired lead still
// parses so a stale program is declined with the respelling rather than
// silently accepted — the retired-`~>` precedent. Parse-only; never lowered.

// Reserved `oper` operation member: `oper name(params) -> Result`.
data NatOp : Type {
  Zero : NatOp;
  Succ : (n : NatOp) --> NatOp;
  oper add(m : NatOp, n : NatOp) -> NatOp;
}

// Reserved `rule` 2-cell member: `rule lhs ==> rhs` (a directed rewrite).
data NatRule : Type {
  Zero : NatRule;
  Succ : (n : NatRule) --> NatRule;
  rule id(Zero) ==> Zero;
}

// The RETIRED `op` member lead — parses, declines with the respelling hint.
data NatRetired : Type {
  Zero : NatRetired;
  op stale(x : NatRetired) -> NatRetired;
}
