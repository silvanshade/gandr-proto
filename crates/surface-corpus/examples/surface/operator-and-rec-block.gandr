// W4d surface fold-in — operator-fixity declarations and the `rec` block.
//
// GRADUATION: both are reserved parse-and-decline. The operator-fixity form
// `op <fixity> <level> "spelling" ;` reuses the reserved `op` lead and a
// string-literal spelling (so the labeler needs no user-operator token); the
// actual per-module wiring remains unbuilt. The `rec { … }` block now opens one
// mutual-recursion scope for marked member calls; executable group lowering
// remains unbuilt. Parse-only; never lowered.

// Operator-fixity declarations (each fixity class parses).
op infixl 6 "<|>" ;
op infixr 5 "<>" ;
op prefix 9 "!" ;
op postfix 9 "?" ;

// A mutual-recursion block with marked cross-member calls.
rec {
  def even(n: Integer) -> F Bool { ret odd[<](n) }
  def odd(n: Integer) -> F Bool { ret even[<](n) }
}
