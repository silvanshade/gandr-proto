// The internal-wire binder: a circuit body's names outside its head's
// interface are wires, and the name-set fold binds them (parse-only fixture).
//
// GRADUATION: the spellings are ruled at
// docs/gandr/spec/surface-language/circuit-cells.md, "The block form, ruled".
// Circuit members are parse-and-decline at lowering and graduate to accepted
// behind the gate under gandr-ng9.1.5. Parse-only; never lowered.
//
// The discipline in one line: each wire name is produced exactly once and
// consumed exactly once, the head declares the interface, and a body name not
// in it is internal — computed by the fold, never declared. So a misspelled
// wire is a linearity question rather than a silent fresh name.
//
// Every block below is well-formed, so the fold binds and refuses nothing. Its
// refutations are the sibling `circuit-shared-ports.gandr`.

// A congruence cell: two disjoint redexes whose outputs meet in one frame.
// `x′` and `y′` sit in no port list, so the fold binds them — each flowing
// from a redex output to a frame input, which is the shape a term syntax
// cannot write because a term has one root.
sign Cong {
  sort Nat : Type
  oper add : (l : Nat, r : Nat) --> (sum : Nat)

  rule cong2 : (
    rule p : Nat ==> Nat,
    rule q : Nat ==> Nat,
    data x : Nat,
    data y : Nat
  ) ==> (z : Nat) {
    node : p(x) ==> (x′);
    node : q(y) ==> (y′);
    node : add(x′, y′) --> (z);
  }
}

// Internal wires chain: `m1` is produced by one frame line and consumed by the
// next, `m2` likewise, and neither is ever written in a port list. The
// occurrence labels name the faces without naming any wire.
sign Chain {
  sort Nat : Type
  oper f : (a : Nat) --> (b : Nat)
  oper g : (a : Nat) --> (b : Nat)
  oper h : (a : Nat) --> (b : Nat)

  oper pipeline : (i : Nat) --> (o : Nat) {
    node s1 : f(i) --> (m1);
    node s2 : g(m1) --> (m2);
    node s3 : h(m2) --> (o);
  }
}

// The stateful wheel: `feed` is the only cycle-forming statement, and both
// wires it closes over are internal — `next` runs from the node line into the
// feed, `state` back out of it and into the same node line.
oper accumulate : (stream : Stream) --> (out : Stream) {
  node : zip(stream, state) --> (next, out);
  feed : (next) --> (state);
}

// The sugar ladder's fresh-name rung: `_` mints a fresh wire in order, so two
// `_` ports on one side are two wires rather than one name used twice, and
// none of them is referable by name. A fold that keyed on the spelling `_`
// would report four shared ports here; the ruled reading reports none.
oper split : (b : Bit) --> (_ : Bit, _ : Bit) {
  node : tee(b) --> (_, _);
}
