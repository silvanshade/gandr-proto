// W4d surface fold-in — `def rec` recursion and copattern bodies (parse-only).
//
// GRADUATION: `def rec` folds into the def family now (wyrd-ku0f) as a fourth
// tail discriminating on the `rec` keyword, so `def` keeps ONE form-first mold;
// user-recursion / corecursion SEMANTICS graduate under wyrd-u7m5 (today the
// `list` builtins are the iteration surface). Parse-only; never lowered.

// An ordinary recursive definition: `def rec` + a statement body.
def rec fact(n: Integer) -> F Integer {
  if eq(n, 0) { ret 1 } else { let m <- fact(minus(n, 1)); ret times(n, m) }
}

// A corecursive definition: the body is a list of copattern clauses `.obs => e`.
def rec nats(n: Integer) -> Stream(Integer) {
  .head => n,
  .tail => nats(plus(n, 1))
}

// The reserved default copattern arm `_ => e` (ADR-66 §3.2) rides the clause
// list beside the projection clauses.
def rec loopy(n: Integer) -> Stream(Integer) {
  .head => n,
  _ => nats(n)
}
