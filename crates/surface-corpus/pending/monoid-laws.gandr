// Integer addition as a monoid, one def per law.
//
// Not in the walked corpus until the laws check. The stated Path
// carrier is Integer. Endpoints are applications of defined mul and
// unit. here-based witnesses. Conversion across those definitions is
// the populate slice.

def unit = 0;

def mul(x: Integer, y: Integer) -> F Integer {
  ret x + y
}

def unitL(x: Integer) -> F Path(Integer, mul(unit, x), x) {
  ret here(x)
}

def unitR(x: Integer) -> F Path(Integer, mul(x, unit), x) {
  ret here(x)
}

def assoc(x: Integer, y: Integer, z: Integer) -> F Path(Integer, mul(mul(x, y), z), mul(x, mul(y, z))) {
  ret here(mul(mul(x, y), z))
}
