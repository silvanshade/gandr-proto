MkComponent
  anchor_spec_index
  "gandr specification corpus"
  StatusPartial
  BaseAnchor
  BaseAnchor
  (ConsSection (MkSection
       anchor_si_about
       "About this corpus"
       InheritSectionStatus
       (ConsBlock (ProseBlock
            (ConsInline (Txt
                 "This is the central index of the gandr specification corpus. Each component is a status-attributed unit authored in the custom component vocabulary and validated by the doc tool (parse equals validate).")
              BaseInline))
         BaseBlock))
    (ConsSection (MkSection
         anchor_si_conventions
         "Conventions"
         InheritSectionStatus
         (ConsBlock (ProseBlock
              (ConsInline (Txt
                   "Every component declares a required status, defines its terms inline (define-once corpus-wide), declares its cite keys, and records typed provenance edges. The designed build will render no-JavaScript static pages; math and diagram leaves will compile to inline vector graphics.")
                BaseInline))
           BaseBlock))
      BaseSection))
  BaseCiteKey
