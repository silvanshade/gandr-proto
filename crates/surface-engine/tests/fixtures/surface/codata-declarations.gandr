// W4d surface fold-in — `codata` datatype declarations (the elaborated
// fixture).
//
// `codata` takes the same head discipline as `data` (typed parameter binders
// plus the index-arity annotation); the members are lowercase-led
// observations, which are not generators, so no result-head discipline
// applies to them. `codata` reserves as one whole keyword, so it never lexes
// as `co` + `data`.

// A stream: each observation is `name : Type`.
codata Stream(a : Type) : Type {
  head : a;
  tail : Stream(a);
}

// An anonymous record type inside an observation is already grammatical.
codata Iter(a : Type) : Type {
  next : F(Option(#{ item : a, rest : Iter(a) }));
}

// Reserved parameterized observation `ap(x : a) : b`, and a reserved grade
// prefix on an observation.
codata Fun(a : Type, b : Type) : Type {
  ap(x : a) : b;
}

codata Session : Type {
  1 step : F(Unit);
}

// Reserved `rule` 2-cell member also rides the codata block.
codata Colist(a : Type) : Type {
  head : a;
  tail : Colist(a);
  rule tail(x) ==> x;
}
