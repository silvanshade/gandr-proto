MkComponent
  anchor_component_vocabulary
  "The component vocabulary"
  StatusPartial
  BaseAnchor
  (ConsAnchor anchor_spec_index BaseAnchor)
  (ConsSection (MkSection
       anchor_cv_overview
       "Overview"
       InheritSectionStatus
       (ConsBlock (ProseBlock
            (ConsInline (Txt "A")
              (ConsInline (TermDef term_component "component")
                (ConsInline (Txt
                     "is the single document class of the specification corpus: a versioned root element carrying a required")
                  (ConsInline (TermDef term_status "status")
                    (ConsInline (Txt
                         "and an ordered list of blocks. This file is itself a component describing the vocabulary, so it exercises every block type. The block taxonomy is seeded from a proven manual chapter shape and Lean-style titled boxes")
                      (ConsInlineGlued (CiteRef cite_P_2)
                        (ConsInline (Txt ".")
                          BaseInline))))))))
         (ConsBlock (ProseBlock
              (ConsInline (Txt "Each")
                (ConsInline (TermRef term_component)
                  (ConsInline (Txt
                       "defines its terms once and references them thereafter; the validator enforces define-once and resolution across the whole corpus. The")
                    (ConsInline (TermRef term_status)
                      (ConsInline (Txt "attribute is required.")
                        BaseInline))))))
           BaseBlock)))
    (ConsSection (MkSection
         anchor_cv_blocks
         "Block types"
         InheritSectionStatus
         (ConsBlock (DefinitionBlock
              anchor_cv_def_prose
              term_prose
              (ConsInline (Txt "A paragraph of inline content: literal text, inline math such as")
                (ConsInlineGlued (MathInline "tilde(mu)")
                  (ConsInline (Txt ", term references, cite references, and inline syntax fragments such as")
                    (ConsInlineGlued (CodeInline "def rec")
                      (ConsInline (Txt ".")
                        BaseInline))))))
           (ConsBlock (GrammarBlock
                (ConsProduction (MkProduction "component" "'<component>' status blocks* '</component>'")
                  (ConsProduction (MkProduction
                       "block"
                       "section | prose | judgements | grammar | rule | definition | diagram | code | example | list | table | references")
                    (ConsProduction (MkProduction
                         "status"
                         "built | partial | adopted-unbuilt | design-pass | dormant")
                      BaseProduction))))
             (ConsBlock (JudgementsBlock
                  "Judgement forms"
                  (ConsMathRow (MkMathRow "Gamma tack.r e : A")
                    (ConsMathRow (MkMathRow "cut(A) tack.r Delta")
                      BaseMathRow)))
               (ConsBlock (RuleBlock
                    anchor_cv_rule_app
                    "T-App"
                    (ConsMathRow (MkMathRow "Gamma tack.r e_1 : A -> B")
                      (ConsMathRow (MkMathRow "Gamma tack.r e_2 : A")
                        BaseMathRow))
                    (MkMathRow "Gamma tack.r e_1 e_2 : B"))
                 (ConsBlock (ProseBlock
                      (ConsInline (Txt
                           "The payload register of the two-register weave, exercised: dictionary, decision, and staging content authors as a")
                        (ConsInline (TermRef term_component)
                          (ConsInline (Txt
                               "table; enumerated registers as a list; normative API surfaces as an api-role code block — the schema itself is the example — and section-granular links as refs. Each exists so a class of dense payload never has to flatten into prose.")
                            BaseInline))))
                   (ConsBlock (InventoryBlock
                        "The payload blocks and links of the two-register weave"
                        (MkHeaderRow
                           (ConsCell (MkCell
                                (ConsInline (Txt "Block")
                                  BaseInline))
                             (ConsCell (MkCell
                                  (ConsInline (Txt "Shape")
                                    BaseInline))
                               (ConsCell (MkCell
                                    (ConsInline (Txt "Payload role")
                                      BaseInline))
                                 BaseCell))))
                        (ConsRow (MkBodyRow
                             (ConsCell (MkCell
                                  (ConsInline (Txt "table")
                                    BaseInline))
                               (ConsCell (MkCell
                                    (ConsInline (Txt "caption, header row, body rows of inline cells")
                                      BaseInline))
                                 (ConsCell (MkCell
                                      (ConsInline (Txt
                                           "Dictionary, decision, mapping, and staging tables — never flattened to prose.")
                                        BaseInline))
                                   BaseCell))))
                          (ConsRow (MkBodyRow
                               (ConsCell (MkCell
                                    (ConsInline (Txt "list")
                                      BaseInline))
                                 (ConsCell (MkCell
                                      (ConsInline (Txt "ordered flag, items with an optional bold lead")
                                        BaseInline))
                                   (ConsCell (MkCell
                                        (ConsInline (Txt "Enumerated registers: obligations, open questions, residual seams.")
                                          BaseInline))
                                     BaseCell))))
                            (ConsRow (MkBodyRow
                                 (ConsCell (MkCell
                                      (ConsInline (Txt "code (api role)")
                                        BaseInline))
                                   (ConsCell (MkCell
                                        (ConsInline (Txt "verbatim signatures, no expectation attributes")
                                          BaseInline))
                                     (ConsCell (MkCell
                                          (ConsInline (Txt
                                               "Normative API surfaces — typed signatures and data layouts, never executed.")
                                            BaseInline))
                                       BaseCell))))
                              (ConsRow (MkBodyRow
                                   (ConsCell (MkCell
                                        (ConsInline (Txt "ref")
                                          BaseInline))
                                     (ConsCell (MkCell
                                          (ConsInline (Txt "inline, targets a corpus anchor")
                                            BaseInline))
                                       (ConsCell (MkCell
                                            (ConsInline (Txt
                                                 "Cross-component and section-granular links; the readability answer to density, validated like term and cite.")
                                              BaseInline))
                                         BaseCell))))
                                BaseRow)))))
                     (ConsBlock (RegisterBlock
                          OrderedList
                          (ConsItem (MkItem
                               "first"
                               (ConsInline (Txt "Every load-bearing artifact lives in a block.")
                                 BaseInline))
                            (ConsItem (MkItem
                                 "second"
                                 (ConsInline (Txt "Every block gets an introducing prose paragraph.")
                                   BaseInline))
                              (ConsItem (MkItem
                                   "third"
                                   (ConsInline (Txt
                                        "Density is answered by spreading out, explaining, and linking — as this section's")
                                     (ConsInline (XRef anchor_cv_examples)
                                       (ConsInline (Txt "link illustrates — never by dropping.")
                                         BaseInline))))
                                BaseItem))))
                       (ConsBlock (ApiCodeBlock
                            "rust"
                            "// The block taxonomy, quoted from the normative schema (workflow-docs::model)\n#[derive(Clone, Debug, Eq, PartialEq)]\n#[non_exhaustive]\npub enum Block {\n    Section(Section), Prose(Vec<Inline>), Judgements(Judgements),\n    Grammar(Vec<Production>), Rule(Rule), Definition(Definition),\n    Diagram(Diagram), Code(CodeBlock), Example(Example),\n    List(List), Table(Table), References(Vec<CiteKey>),\n}")
                         (ConsBlock (DiagramBlock
                              anchor_cv_diagram
                              "A component contains sections, which contain blocks."
                              cite_A_1a
                              "#diagram(\n  node((0,0), [component]),\n  node((1,0), [section]),\n  node((1,1), [block]),\n  edge((0,0), (1,0), [contains], \"->\"),\n  edge((1,0), (1,1), [contains], \"->\"),\n  edge((0,0), (1,1), [reaches], \"-->\"),\n)")
                           BaseBlock))))))))))
      (ConsSection (MkSection
           anchor_cv_examples
           "Checked examples"
           InheritSectionStatus
           (ConsBlock (ExampleBlock
                "A code block anticipating output"
                (ConsBlock (ProseBlock
                     (ConsInline (Txt
                          "Code blocks structurally anticipate checked examples. The tool validates the shape of the expectation but never executes it.")
                       BaseInline))
                  (ConsBlock (ExpectCodeBlock "gandr" "6" "{ val x = 1 + 2 + 3; x }")
                    BaseBlock)))
             BaseBlock))
        BaseSection)))
  (ConsCiteKey cite_P_2
    (ConsCiteKey cite_A_1a BaseCiteKey))
