MkComponent
  anchor_recursion_surface
  "The (co)recursion surface: recursive scope and call-site evidence markers"
  StatusPartial
  (ConsAnchor anchor_core_ir
    (ConsAnchor anchor_data_patterns
      (ConsAnchor anchor_sequent_kernel BaseAnchor)))
  (ConsAnchor anchor_spec_index BaseAnchor)
  (ConsSection (MkSection
       anchor_rs_overview
       "Overview and the decision"
       InheritSectionStatus
       (ConsBlock (ProseBlock
            (ConsInline (Txt
                 "This component fixes where recursion and corecursion are declared, where their termination and productivity evidence lives, and how that evidence surface grows into sized types, cost annotations, and explicit implicit-instantiation without retrofit.")
              BaseInline))
         (ConsBlock (ProseBlock
              (ConsInline (Txt "The decision is a")
                (ConsInlineGlued (Bold
                     (ConsInline (Txt "hybrid of two sites")
                       BaseInline))
                  (ConsInline (Txt ".")
                    BaseInline))))
           (ConsBlock (ProseBlock
                (ConsInline (Txt "A")
                  (ConsInline (TermDef term_recursive_scope "recursive scope")
                    (ConsInline (Txt "is opened at the declaration:")
                      (ConsInline (CodeInline "def rec")
                        (ConsInline (Txt "for a single self-referential definition, the")
                          (ConsInline (CodeInline "rec { … }")
                            (ConsInline (Txt "block for a mutual group.")
                              BaseInline))))))))
             (ConsBlock (ProseBlock
                  (ConsInline (Txt "A")
                    (ConsInline (TermDef term_recursion_marker "recursion marker")
                      (ConsInline (Txt
                           "is required at every recursive occurrence. The marked occurrence — written in the bracketed instantiation slot, as in")
                        (ConsInline (CodeInline "add[&lt;](p, n)")
                          (ConsInline (Txt
                               "— is the only way to reference a definition from inside its own recursive scope.")
                            BaseInline))))))
               (ConsBlock (ProseBlock
                    (ConsInline (Txt "The")
                      (ConsInlineGlued (TermRef term_recursion_marker)
                        (ConsInline (Txt "'s interior carries a")
                          (ConsInlineGlued (TermDef term_direction_sigil "direction sigil")
                            (ConsInline (Txt ":")
                              (ConsInline (CodeInline "&lt;")
                                (ConsInline (Txt "claims descent into an inductive argument,")
                                  (ConsInline (CodeInline "&gt;")
                                    (ConsInline (Txt "claims guarded production of coinductive output.")
                                      BaseInline))))))))))
                 (ConsBlock (ProseBlock
                      (ConsInline (Txt "Declaration-site rec is")
                        (ConsInlineGlued (Bold
                             (ConsInline (Txt "scope information")
                               BaseInline))
                          (ConsInline (Txt "; the call-site marker is")
                            (ConsInlineGlued (Bold
                                 (ConsInline (Txt "evidence information")
                                   BaseInline))
                              (ConsInline (Txt ".")
                                BaseInline))))))
                   (ConsBlock (ProseBlock
                        (ConsInline (Txt "They answer different questions, so")
                          (ConsInlineGlued (Bold
                               (ConsInline (Txt "carrying both is not redundancy")
                                 BaseInline))
                            (ConsInline (Txt ".")
                              BaseInline))))
                     (ConsBlock (ProseBlock
                          (ConsInline (Txt "As built, the surface grammar accepts")
                            (ConsInlineGlued (CodeInline "def rec")
                              (ConsInline (Txt ",")
                                (ConsInlineGlued (CodeInline "rec { … }")
                                  (ConsInline (Txt
                                       ", bracketed direction sigils, comma lists, and the reserved marker residents.")
                                    BaseInline))))))
                       (ConsBlock (ProseBlock
                            (ConsInline (Txt
                                 "A pre-lowering scope pass then validates the surface: marked self or group references are required, and unmarked self-reference is rejected with the marked spelling as a suggestion. Qualified access to outer bindings survives, and the reserved residents are declined by name.")
                              BaseInline))
                         (ConsBlock (ProseBlock
                              (ConsInline (Txt
                                   "Recursive and corecursive definitions themselves do not yet lower; the direction sigils therefore carry")
                                (ConsInline (Bold
                                     (ConsInline (Txt "scope evidence only")
                                       BaseInline))
                                  (ConsInline (Txt "— not guardedness, size, or cost claims.")
                                    BaseInline))))
                           (ConsBlock (ProseBlock
                                (ConsInline (Txt "Three consequences are the point of the design. First, the")
                                  (ConsInlineGlued (Bold
                                       (ConsInline (Txt "rec-versus-nonrec declaration dichotomy is eliminated")
                                         BaseInline))
                                    (ConsInline (Txt
                                         ". Every plain name reference means the same thing everywhere — the enclosing or imported binding. Self-reference is always explicit, so a")
                                      (ConsInline (CodeInline "nonrec")
                                        (ConsInline (Txt "keyword has nothing left to mean.")
                                          BaseInline))))))
                             (ConsBlock (ProseBlock
                                  (ConsInline (Txt "Second, the surface becomes")
                                    (ConsInlineGlued (Bold
                                         (ConsInline (Txt "honest to the elaboration")
                                           BaseInline))
                                      (ConsInline (Txt ". The core design elaborates recursion through thunks over the")
                                        (ConsInline (TermRef term_frozen_core)
                                          (ConsInline (Txt
                                               "call-by-push-value substrate. Under it, a recursive occurrence is the fix-bound variable — a different binding than the definition's name. The marker surfaces exactly that distinction instead of hiding it behind name capture.")
                                            BaseInline))))))
                               (ConsBlock (ProseBlock
                                    (ConsInline (Txt "Third, every recursive call carries a")
                                      (ConsInlineGlued (Bold
                                           (ConsInline (Txt "syntactic slot")
                                             BaseInline))
                                        (ConsInline (Txt
                                             ". The productivity ladder, the cost model, and explicit implicit-instantiation can all later hang on it, because the slot is the instantiation slot the expression grammar already has.")
                                          BaseInline))))
                                 BaseBlock))))))))))))))
    (ConsSection (MkSection
         anchor_rs_evidence_site
         "Where termination evidence lives"
         InheritSectionStatus
         (ConsBlock (ProseBlock
              (ConsInline (Txt
                   "Prior art splits by the site where a definition's well-foundedness evidence attaches. Declaration-site systems attach a measure to the definition: Lean's")
                (ConsInline (CodeInline "termination_by")
                  (ConsInline (Txt "/")
                    (ConsInline (CodeInline "decreasing_by")
                      (ConsInline (Txt
                           "clauses, ATS's termination metrics in the signature, Liquid Haskell's")
                        (ConsInline (CodeInline "decrease")
                          (ConsInline (Txt "annotations.")
                            BaseInline))))))))
           (ConsBlock (ProseBlock
                (ConsInline (Txt "Call-site systems attach evidence to the occurrence: Idris's")
                  (ConsInlineGlued (CodeInline "assert_smaller")
                    (ConsInline (Txt ", and — the popularly-known case — Clojure's")
                      (ConsInlineGlued (CodeInline "recur")
                        (ConsInline (Txt ".")
                          BaseInline))))))
             (ConsBlock (ProseBlock
                  (ConsInline (Txt
                       "The Clojure precedent needs a correction before it can inform the design.")
                    (ConsInline (CodeInline "recur")
                      (ConsInline (Txt
                           "is tail-position-only and self-only, and it exists because the JVM lacks tail-call elimination. It is")
                        (ConsInlineGlued (Bold
                             (ConsInline (Txt "a loop construct wearing recursion syntax")
                               BaseInline))
                          (ConsInline (Txt ", not a general recursion marker.")
                            BaseInline))))))
               (ConsBlock (ProseBlock
                    (ConsInline (Txt "The nearest honest description of this design is \"Idris's")
                      (ConsInline (CodeInline "assert_smaller")
                        (ConsInline (Txt
                             "made systematic and mandatory\": unusual as a required form, but not unprecedented as a site.")
                          BaseInline))))
                 (ConsBlock (ProseBlock
                      (ConsInline (Txt
                           "Call-site evidence wins for gandr on four grounds. The checker's obligations attach where the proof burden actually is —")
                        (ConsInlineGlued (Bold
                             (ConsInline (Txt "each marked call is one obligation")
                               BaseInline))
                          (ConsInline (Txt
                               ", and a diagnostic names the call that fails, not the definition that contains it somewhere.")
                            BaseInline))))
                   (ConsBlock (ProseBlock
                        (ConsInline (Txt "The cost model reads the same sites: the calf substrate")
                          (ConsInline (CiteRef cite_L_1)
                            (ConsInline (CiteRef cite_L_2)
                              (ConsInline (Txt
                                   "extracts recurrences at recursive calls, so a per-call slot is exactly where a cost bound will later live.")
                                BaseInline)))))
                     (ConsBlock (ProseBlock
                          (ConsInline (Txt
                               "Sized types read the same sites again. Under well-founded sized recursion")
                            (ConsInlineGlued (CiteRef cite_O_1b)
                              (ConsInline (Txt
                                   ", a recursive call is an application at a strictly smaller size. The marker is therefore not an ad-hoc invention that sized types would replace. It is the surface position that size instantiation will occupy, adopted early with lighter semantics.")
                                BaseInline))))
                       (ConsBlock (ProseBlock
                            (ConsInline (Txt "And mutual recursion generalizes cleanly: inside even, the call")
                              (ConsInline (CodeInline "odd[&lt;](p)")
                                (ConsInline (Txt
                                     "marks a recursive-group call at smaller size, which a self-only construct like")
                                  (ConsInline (CodeInline "recur")
                                    (ConsInline (Txt "cannot express and a sized-type semantics handles by construction.")
                                      BaseInline))))))
                         (ConsBlock (ProseBlock
                              (ConsInline (Txt
                                   "The noise objection — a prover-flavored language recurses constantly, and every call pays three characters — is acknowledged and priced. A prover requires termination evidence somewhere; the design question is only its address.")
                                BaseInline))
                           (ConsBlock (ProseBlock
                                (ConsInline (Txt
                                     "Agda's answer (a silent structural checker, escalating to size quantifiers in types when it fails) puts the noise in the types, which is more total noise at a worse address. Three characters at the call is close to the")
                                  (ConsInline (Bold
                                       (ConsInline (Txt "minimum honest notation")
                                         BaseInline))
                                    (ConsInline (Txt "for evidence the checker needs anyway.")
                                      BaseInline))))
                             (ConsBlock (ProseBlock
                                  (ConsInline (Txt
                                       "The tylr parser lineage decouples stored syntax from displayed syntax, because identity there is whitespace-invariant and merkle-keyed. Prover-facing renderings may therefore elide inferable markers as a projection concern, without the grammar or the stored term changing.")
                                    BaseInline))
                               BaseBlock))))))))))))
      (ConsSection (MkSection
           anchor_rs_scope_rule
           "Recursive scope and self-reference"
           (WithSectionStatus StatusPartial)
           (ConsBlock (ProseBlock
                (ConsInline (Txt
                     "Call-site-only marking was considered and rejected. Mutual recursion needs declaration-site grouping regardless of any call-site discipline: inside even, a call to odd requires odd in scope before odd's definition is complete. Something must open the group's scope, and that is precisely the reserved")
                  (ConsInline (CodeInline "rec { … }")
                    (ConsInline (Txt "block.")
                      BaseInline))))
             (ConsBlock (ProseBlock
                  (ConsInline (Txt
                       "The alternative that dissolves the problem — the whole file as one implicit letrec scope, the Rust and Haskell posture — is rejected on principle.")
                    (ConsInlineGlued (Bold
                         (ConsInline (Txt
                              "Implicit recursion everywhere is exactly the default this design exists to remove")
                           BaseInline))
                      (ConsInline (Txt ".")
                        BaseInline))))
               (ConsBlock (ProseBlock
                    (ConsInline (Txt
                         "So the choice is not declaration-site versus call-site; it is declaration-site alone versus")
                      (ConsInline (Bold
                           (ConsInline (Txt "both")
                             BaseInline))
                        (ConsInline (Txt "— and both is what makes the evidence discipline possible.")
                          BaseInline))))
                 (ConsBlock (ProseBlock
                      (ConsInline (Txt
                           "The self-reference rule makes the hybrid safe. Inside a recursive scope,")
                        (ConsInlineGlued (Bold
                             (ConsInline (Txt
                                  "the marked occurrence is the only reference to the fix-bound variable")
                               BaseInline))
                          (ConsInline (Txt
                               ". An unmarked occurrence of the definition's own name is a hard error carrying a did-you-mean suggestion naming the marked form — never a silent resolution. An outer or imported binding of the same name remains reachable, but only through a qualified path.")
                            BaseInline))))
                   (ConsBlock (ProseBlock
                        (ConsInline (Txt
                             "The error-not-capture clause matters more than it first appears. Under the naive alternative — \"a plain name resolves to the outer binding\" — forgetting one marker silently captures an imported or shadowed binding of the same name. That is a strictly worse footgun than the shadowing confusions nonrec was invented to manage. The rule as stated kills the footgun and the nonrec keyword with one stroke, and the qualified-path escape keeps the legitimate outer-reference idiom expressible.")
                          BaseInline))
                     (ConsBlock (ProseBlock
                          (ConsInline (Txt
                               "The declaration-site half also keeps its independent value. A reader — or the")
                            (ConsInline (TermRef term_decl_table)
                              (ConsInline (Txt
                                   "— learns from the header alone that a definition is self-referential, without scanning the body for markers. And the surface grammar keeps def rec folded as a tail of the single def family: one form-first mold, the rec-versus-name choice locally decidable. The scope keyword therefore costs no new shared-prefix window.")
                                BaseInline))))
                       BaseBlock)))))))
        (ConsSection (MkSection
             anchor_rs_marker_slot
             "The instantiation slot"
             (WithSectionStatus StatusPartial)
             (ConsBlock (ProseBlock
                  (ConsInline (Txt
                       "The load-bearing syntactic finding is that the bracket plane already exists. The expression grammar already has a postfix bracketed instantiation form, e[T, …]. And the bracket plane already uniformly denotes the erased, second-class tier: type instantiation e[T], type abstraction fn [a] { … }, the")
                    (ConsInline (TermRef term_grade)
                      (ConsInline (Txt "slot thunk [g] { … }.")
                        BaseInline))))
               (ConsBlock (ProseBlock
                    (ConsInline (Txt "The recursion marker is therefore")
                      (ConsInlineGlued (Bold
                           (ConsInline (Txt "not a new syntax class")
                             BaseInline))
                        (ConsInline (Txt ": it is the existing")
                          (ConsInline (TermDef term_instantiation_slot "instantiation slot")
                            (ConsInline (Txt
                                 "admitting two new interior atoms, the direction sigils. Under the sized-types rung of the ladder, this stops being a pun. It becomes literally true: f[&lt;] is instantiation of an erased size argument at a fresh size strictly below the ambient one.")
                              BaseInline))))))
                 (ConsBlock (GrammarBlock
                      (ConsProduction (MkProduction "e" "e [ ι₁, …, ιₙ ] | e ( e₁, …, eₘ ) | …")
                        (ConsProduction (MkProduction "ι" "T | < | > | x = e | m < | size = e | cost = e | tail")
                          BaseProduction)))
                   (ConsBlock (ProseBlock
                        (ConsInline (Txt
                             "The slot is a comma list from day one, in the same anti-retrofit posture as the reserved productions of the")
                          (ConsInline (TermRef term_data_declaration)
                            (ConsInline (Txt
                                 "block. The grammar accepts the full list, and the checker declines every resident it does not yet implement.")
                              BaseInline))))
                     (ConsBlock (ProseBlock
                          (ConsInline (Txt
                               "Four future residents are named and reserved now, so that none is a retrofit. Named measures (f[m &lt;]) say which argument descends. Explicit size instantiation is f[size = e], and cost bounds are f[cost = e] in the calf reading")
                            (ConsInlineGlued (CiteRef cite_L_1)
                              (ConsInline (Txt ". A tail atom asserts that the call must compile as a tail call.")
                                BaseInline))))
                       (ConsBlock (ProseBlock
                            (ConsInline (Txt
                                 "A function that recurses on an inductive argument while corecursing into its coinductive result marks one call with a list, f[&lt;, &gt;] — which is why")
                              (ConsInline (Bold
                                   (ConsInline (Txt "the")
                                     BaseInline))
                                (ConsInline (TermRef term_instantiation_slot)
                                  (ConsInlineGlued (Bold
                                       (ConsInline (Txt "cannot be a single atom")
                                         BaseInline))
                                    (ConsInline (Txt ".")
                                      BaseInline))))))
                         (ConsBlock (ProseBlock
                              (ConsInline (Txt
                                   "The implicit-arguments interaction resolves by unification rather than collision. Term-level implicits arrive by contextual-metavariable elaboration (the D9 line of the kernel synthesis), and any implicit system eventually needs an explicit-instantiation surface. That surface is this same slot, f[i = e]: one occurrence-modifier slot then serves type arguments, sizes, direction sigils, and explicit implicit instantiation, instead of two bracket languages competing for one opener.")
                                BaseInline))
                           (ConsBlock (ProseBlock
                                (ConsInline (Txt "Module-level implicits in the modular-implicits line")
                                  (ConsInline (CiteRef cite_H_4)
                                    (ConsInline (Txt
                                         "live at the signature/functor layer and are unaffected by any of this.")
                                      BaseInline))))
                             BaseBlock)))))))))
          (ConsSection (MkSection
               anchor_rs_ladder
               "The productivity ladder"
               (WithSectionStatus StatusPartial)
               (ConsBlock (ProseBlock
                    (ConsInline (Txt "The")
                      (ConsInline (TermDef term_productivity_ladder "productivity ladder")
                        (ConsInline (Txt
                             "is the staged strengthening of what a marker means: step budget now, syntactic guardedness next, sized types reserved.")
                          BaseInline))))
                 (ConsBlock (ProseBlock
                      (ConsInline (Txt
                           "On the first rung the marker is scope-checked only: a marked occurrence must target a definition of the enclosing recursive scope, and nothing else is claimed. Evaluation remains bounded by the machine step budget, with decline-and-report.")
                        BaseInline))
                   (ConsBlock (ProseBlock
                        (ConsInline (Txt
                             "On the guardedness rung the sigils become checked claims. &lt; obliges some argument of the marked call to structurally descend. &gt; obliges the marked call to sit under at least one copattern observation — the standard guard discipline of copattern corecursion")
                          (ConsInlineGlued (CiteRef cite_O_1a)
                            (ConsInline (Txt ".")
                              BaseInline))))
                     (ConsBlock (ProseBlock
                          (ConsInline (Txt
                               "On the sized rung both sigils elaborate to erased size applications, and the explicit forms become available in the same slot. Conversion quotients the annotations under size-irrelevance")
                            (ConsInlineGlued (CiteRef cite_O_2)
                              (ConsInline (Txt ", as the kernel's gluing design already anticipates.")
                                BaseInline))))
                       (ConsBlock (ProseBlock
                            (ConsInline (Txt
                                 "One normative caveat is fixed now so the sized rung inherits no lie. In the sized-type semantics")
                              (ConsInline (CiteRef cite_O_1b)
                                (ConsInline (Txt
                                     "both recursion and corecursion consume size: a coinductive type sized by observation depth has its corecursive call at strictly smaller depth, exactly as an inductive traversal descends.")
                                  BaseInline))))
                         (ConsBlock (ProseBlock
                              (ConsInline (Txt
                                   "Both sigils therefore mean the same thing normatively: instantiate at a fresh size strictly below the ambient size. The &lt;/&gt; split is")
                                (ConsInlineGlued (Bold
                                     (ConsInline (Txt "presentational")
                                       BaseInline))
                                  (ConsInline (Txt
                                       ", keyed to the polarity of the type being traversed or produced — &lt; when the descent is into a positive argument, &gt; when the production is of a negative result. The split is kept anyway: the consuming-input/producing-output distinction is what a human reader wants at the call. The spec simply refuses to pretend it is a semantic distinction.")
                                    BaseInline))))
                           (ConsBlock (ProseBlock
                                (ConsInline (Txt "The")
                                  (ConsInlineGlued (TermRef term_productivity_ladder)
                                    (ConsInline (Txt
                                         "'s ordering is also a soundness hedge. Sized types have a troubled implementation history: the interaction of bounded size quantification with the infinite size produced real inconsistencies in Agda's implementation. The underlying theory in the MiniAgda line")
                                      (ConsInline (CiteRef cite_O_6)
                                        (ConsInline (Txt
                                             "is sound. Keeping the marker's normative MVP semantics at \"scope plus direction claim\", with guardedness checked before any size semantics ships, means")
                                          (ConsInlineGlued (Bold
                                               (ConsInline (Txt
                                                    "nothing downstream depends on sized-type semantics before that rung is deliberately designed")
                                                 BaseInline))
                                            (ConsInline (Txt ".")
                                              BaseInline))))))))
                             BaseBlock))))))))
            (ConsSection (MkSection
                 anchor_rs_one_family
                 "One def rec family"
                 InheritSectionStatus
                 (ConsBlock (ProseBlock
                      (ConsInline (Txt "There is deliberately")
                        (ConsInlineGlued (Bold
                             (ConsInline (Txt "no def corec")
                               BaseInline))
                          (ConsInline (Txt ".")
                            BaseInline))))
                   (ConsBlock (ProseBlock
                        (ConsInline (Txt
                             "The body shape already discriminates. A statement body is recursive; a copattern-clause body (.head =&gt; e, .tail =&gt; e) is corecursive. The latter elaborates through the cosplit case-tree node")
                          (ConsInline (CiteRef cite_O_3a)
                            (ConsInline (Txt "to a record of thunks over the existing record former.")
                              BaseInline))))
                     (ConsBlock (ProseBlock
                          (ConsInline (Txt
                               "A second declaration keyword would re-encode information the body carries, and it would cost a second mold in the definition family. Decisively, it would force mixed recursive/corecursive functions to pick a side they do not have. A stream transformer descends an inductive argument while producing guarded coinductive output: that is one definition whose calls carry [&lt;, &gt;], not two definitions.")
                            BaseInline))
                       (ConsBlock (ProseBlock
                            (ConsInline (Txt
                                 "The single { … } body with an interior alternative also keeps the two body forms from opening two brace-led branches in one context, per the surface grammar's duplicate-tile discipline.")
                              BaseInline))
                         (ConsBlock (ProseBlock
                              (ConsInline (Txt
                                   "The sequent reading is recorded as a correspondence obligation rather than designed here: in the classical account of (co)recursion")
                                (ConsInline (CiteRef cite_O_5)
                                  (ConsInline (Txt "the corecursor's seed sits on the")
                                    (ConsInline (TermRef term_consumer)
                                      (ConsInline (Txt "side of a")
                                        (ConsInlineGlued (TermRef term_cut)
                                          (ConsInline (Txt ". That is dual to the recursor's argument on the")
                                            (ConsInline (TermRef term_producer)
                                              (ConsInline (Txt
                                                   "side. So when the L fragment grows far enough to express it, the &gt;-marked occurrence should acquire an L face as the seed side of a coiterator cut. The marker discipline should survive that translation unchanged; if it does not,")
                                                (ConsInlineGlued (Bold
                                                     (ConsInline (Txt "the surface design — not the kernel — is what must move")
                                                       BaseInline))
                                                  (ConsInline (Txt ".")
                                                    BaseInline))))))))))))
                           BaseBlock))))))
              (ConsSection (MkSection
                   anchor_rs_type_level
                   "Type-level self-reference"
                   InheritSectionStatus
                   (ConsBlock (ProseBlock
                        (ConsInline (Txt
                             "The analogous OCaml pain at the type level — type nonrec t = t — dissolves without new syntax, because its cause is shadowing, not termination. Declared data is")
                          (ConsInlineGlued (TermRef term_generative_nominal)
                            (ConsInline (Txt
                                 ": the declaration mints a fresh nominal id. The rule inside a data block then mirrors the term-level self-reference rule with the marker dropped. The declared name denotes the block's own fresh nominal — data is inherently recursive, and that recursion is what declaring a datatype means. An outer binding of the same name is reachable only by qualified path.")
                              BaseInline))))
                     (ConsBlock (ProseBlock
                          (ConsInlineGlued (Bold
                               (ConsInline (Txt "No termination evidence attaches to type-level self-reference")
                                 BaseInline))
                            (ConsInline (Txt
                                 ", because none is owed at the surface: strict positivity is the checker's obligation over the")
                              (ConsInlineGlued (TermRef term_decl_table)
                                (ConsInline (Txt ", not a claim the author repeats per occurrence.")
                                  BaseInline)))))
                       (ConsBlock (ProseBlock
                            (ConsInline (Txt
                                 "The re-export idiom nonrec existed for is written as a qualified alias instead.")
                              BaseInline))
                         BaseBlock))))
                (ConsSection (MkSection
                     anchor_rs_application_syntax
                     "Application syntax"
                     InheritSectionStatus
                     (ConsBlock (ProseBlock
                          (ConsInline (Txt
                               "Considered alongside this design, and rejected: switching application from f(a, b) to Agda-style juxtaposition f a b. The parser could carry it — the tile calculus already melds juxtaposed atoms inside shell blocks — so the rejection is")
                            (ConsInlineGlued (Bold
                                 (ConsInline (Txt "doctrinal and economic, not technical")
                                   BaseInline))
                              (ConsInline (Txt ".")
                                BaseInline))))
                       (ConsBlock (ProseBlock
                            (ConsInline (Txt "Doctrinally, the")
                              (ConsInline (TermRef term_data_declaration)
                                (ConsInline (Txt
                                     "surface rules that a constructor's surface is a field-tuple, and that writing a constructor as an arrow is a polarity lie. Curried juxtaposition makes partially-applied constructors first-class — turning value introductions into closures mid-application, the exact laundering the constructor rule exists to prevent. Adopting juxtaposition would then force either breaking that rule or splitting the application syntax (constructors parenthesized, functions juxtaposed). Both are worse than either uniform choice.")
                                  BaseInline))))
                         (ConsBlock (ProseBlock
                              (ConsInline (Txt
                                   "Economically: parenthesized application is what makes an arity mistake a parse-adjacent material obligation")
                                (ConsInline (CiteRef cite_I_7a)
                                  (ConsInlineGlued (CiteRef cite_I_7b)
                                    (ConsInline (Txt
                                         ": a missing argument or unclosed call is a located hole, the tile parser's signature diagnostic strength. Juxtaposition demotes every such mistake to a downstream type error. It also makes every adjacency a potential meld — the quadratic-per-block hazard that is the stated reason melding is quarantined to shell blocks.")
                                      BaseInline)))))
                           (ConsBlock (ProseBlock
                                (ConsInline (Txt
                                     "And the genuine notational win of the Agda family is mixfix operators, not juxtaposed application; gandr already reserves that outlet in the operator-declaration form, with tiles-as-data keeping open mixfix a priced option. The notation budget goes there, and prover-facing beauty is a projection/display concern over whitespace-invariant identity, not a grammar concern.")
                                  BaseInline))
                             BaseBlock)))))
                  (ConsSection (MkSection
                       anchor_rs_examples
                       "Examples"
                       (WithSectionStatus StatusAdoptedUnbuilt)
                       (ConsBlock (ExampleBlock
                            "Structural recursion with a marked descending call"
                            (ConsBlock (ProseBlock
                                 (ConsInline (Txt
                                      "The recursive scope is opened by def rec. The one recursive call carries the")
                                   (ConsInline (Bold
                                        (ConsInline (Txt "descending sigil")
                                          BaseInline))
                                     (ConsInline (Txt
                                          "in the instantiation slot. The unmarked spelling add(p, n) inside the body is an error with a did-you-mean suggestion.")
                                       BaseInline))))
                              (ConsBlock (PlainCodeBlock
                                   "text"
                                   "def rec add(m: Nat, n: Nat) -> Nat {\n  case m {\n    Zero    => n,\n    Succ(p) => Succ(add[<](p, n)),\n  }\n}")
                                BaseBlock)))
                         (ConsBlock (ExampleBlock
                              "Corecursion by copatterns with a marked productive call"
                              (ConsBlock (ProseBlock
                                   (ConsInline (Txt "The copattern-clause body selects the")
                                     (ConsInline (Bold
                                          (ConsInline (Txt "corecursive reading")
                                            BaseInline))
                                       (ConsInline (Txt
                                            "of the same def rec family. The corecursive occurrence carries the productive sigil and sits under the .tail observation — exactly what the guardedness rung will check.")
                                         BaseInline))))
                                (ConsBlock (PlainCodeBlock
                                     "text"
                                     "def rec nats(m: Nat) -> Stream(Nat) {\n  .head => m,\n  .tail => nats[>](m + 1),\n}")
                                  BaseBlock)))
                           (ConsBlock (ExampleBlock
                                "A mutual group: markers name group members"
                                (ConsBlock (ProseBlock
                                     (ConsInline (Txt
                                          "The rec block opens one scope for the group. A marked call may target")
                                       (ConsInline (Bold
                                            (ConsInline (Txt "any member")
                                              BaseInline))
                                         (ConsInline (Txt
                                              "— which the self-only recur precedent cannot express and the sized semantics justifies (the group shares the descending size).")
                                           BaseInline))))
                                  (ConsBlock (PlainCodeBlock
                                       "text"
                                       "rec {\n  def even(n: Nat) -> Bool { case n { Zero => true,  Succ(p) => odd[<](p)  } }\n  def odd (n: Nat) -> Bool { case n { Zero => false, Succ(p) => even[<](p) } }\n}")
                                    BaseBlock)))
                             (ConsBlock (ExampleBlock
                                  "A checked recursion example"
                                  (ConsBlock (ProseBlock
                                       (ConsInline (Txt
                                            "The anticipated checked shape once the elaborator lands: a declared datatype, a marked structural recursion over it, and an application. The tool validates the expectation's shape; execution gating waits on the interpreter.")
                                         BaseInline))
                                    (ConsBlock (ExpectCodeBlock
                                         "gandr"
                                         "Succ(Succ(Zero))"
                                         "data Nat { Zero, Succ(n: Nat) }\nin def rec add(m: Nat, n: Nat) -> Nat {\n  case m { Zero => n, Succ(p) => Succ(add[<](p, n)) }\n}\nin add(Succ(Zero), Succ(Zero))")
                                      BaseBlock)))
                               BaseBlock)))))
                    (ConsSection (MkSection
                         anchor_rs_edge
                         "Edge cases and non-decisions"
                         (WithSectionStatus StatusPartial)
                         (ConsBlock (ProseBlock
                              (ConsInline (Txt
                                   "Escaping self-reference: a marked occurrence that is not a call — fold(add[&lt;], xs), the definition passed to a higher-order function. The grammar admits it, because the slot is an instantiation form over any operand. The guardedness rung declines it, because structural descent through an escaping reference is not syntactically checkable. The sized rung accepts it, because a partially size-instantiated reference is meaningful.")
                                (ConsInlineGlued (Bold
                                     (ConsInline (Txt "The decline is designed, not accidental")
                                       BaseInline))
                                  (ConsInline (Txt ", and the diagnostic must say which rung refused it.")
                                    BaseInline))))
                           (ConsBlock (ProseBlock
                                (ConsInline (Txt
                                     "Sigil molding passed its implementation gate: &lt; and &gt; are operator tiles, but the instantiation slot has its own grammar sort in which both sigils mold as atoms, distinct from binary expressions. The duplicate-tile check passes with copattern and postfix dots continuing to mold by context.")
                                  BaseInline))
                             (ConsBlock (ProseBlock
                                  (ConsInline (Txt
                                       "At the current parser rung, a qualified call head in a recursive body is grouped as (outer.f)(args). Removing that grouping requirement is a parser refinement, not a change to the qualified-path escape semantics.")
                                    BaseInline))
                               (ConsBlock (ProseBlock
                                    (ConsInline (Txt
                                         "Adjacent non-decisions, recorded so this component does not silently spend them. The")
                                      (ConsInline (CodeInline "let")
                                        (ConsInline (Txt "keyword, freed by the value/computation binder pair (")
                                          (ConsInline (CodeInline "val x = v;")
                                            (ConsInline (Txt "/")
                                              (ConsInlineGlued (CodeInline "run x &lt;- c;")
                                                (ConsInline (Txt
                                                     "), stays unassigned. Its strongest claimant is a transparent definitional binder at the dependent-types rung — one whose unfolding is visible to conversion, semantically distinct from")
                                                  (ConsInlineGlued (CodeInline "val")
                                                    (ConsInline (Txt
                                                         "'s opaque bind. Reserving keywords early breaks identifiers for no gain. The")
                                                      (ConsInline (CodeInline "mut")
                                                        (ConsInline (Txt
                                                             "keyword stays unreserved pending the value-semantics/modes design pass. Nothing in this component pre-commits the mutation story to modes over the effect row or the reverse, and the marker slot deliberately carries no aliasing or mode content.")
                                                          BaseInline))))))))))))
                                 (ConsBlock (ProseBlock
                                      (ConsInline (Txt
                                           "Display-layer elision of inferable markers in prover-facing renderings is endorsed as a projection concern and constrains nothing here. Finally, the diagnostic quality bar of the self-reference rule is normative. The unmarked-self-name error must carry the did-you-mean suggestion: the rule's safety argument (error, never capture) assumes the repair is offered, not hunted.")
                                        BaseInline))
                                   BaseBlock))))))
                      (ConsSection (MkSection
                           anchor_rs_architecture
                           "Architecture and API surface"
                           (WithSectionStatus StatusPartial)
                           (ConsBlock (ProseBlock
                                (ConsInline (Txt
                                     "The realized surface splits across three crates, and this section is the map. The grammar plane gives the")
                                  (ConsInline (TermRef term_instantiation_slot)
                                    (ConsInline (Txt
                                         "its own sort. The direction sigils therefore mold as atoms exactly where the slot is expected, and nowhere else — the syntax boundary at which later rungs interpret or decline each resident.")
                                      BaseInline))))
                             (ConsBlock (ProseBlock
                                  (ConsInline (Txt
                                       "The engine hosts the scope pass as a deliberately pre-kernel, pre-lowering stage. Fix-bound names are resolved, and the")
                                    (ConsInlineGlued (TermRef term_instantiation_slot)
                                      (ConsInline (Txt
                                           "'s residents are classified, before ordinary CBPV lowering sees the expression. That is what makes \"the marked occurrence is the only reference to the fix-bound variable\" an")
                                        (ConsInline (Bold
                                             (ConsInline (Txt "exact property")
                                               BaseInline))
                                          (ConsInline (Txt "rather than a convention.")
                                            BaseInline))))))
