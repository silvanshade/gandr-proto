                                              BaseRow))))))
                                 (ConsBlock (ProseBlock
                                      (ConsInline (Txt
                                           "The corpus holds the parse-gated witnesses, firewalled from execution. The signatures below are quoted from the crates as the normative shape this component pins.")
                                        BaseInline))
                                   (ConsBlock (ApiCodeBlock
                                        "rust"
                                        "// surface-engine::lower::recursion_surface — the pre-lowering scope pass\npub(super) fn validate_item(item: SynNode<'_>) -> LowerResult<()>\n\n// surface-engine::lower — the recursion-surface finding family (excerpt)\n#[non_exhaustive]\npub enum LowerError {\n    UnmarkedRecursiveReference { name: String, suggestion: String, byte_range: SourceRange },\n    MarkedReferenceOutsideRecursiveScope { target: String, byte_range: SourceRange },\n    ReservedNamedMeasure { resident: String, byte_range: SourceRange },\n    ReservedExplicitInstantiation { resident: String, byte_range: SourceRange },\n    ReservedExplicitSize { resident: String, byte_range: SourceRange },\n    ReservedCostBound { resident: String, byte_range: SourceRange },\n    ReservedTailAssertion { byte_range: SourceRange },\n}")
                                     (ConsBlock (ProseBlock
                                          (ConsInline (Txt
                                               "Two shape decisions the signatures make visible. First, the grammar admits six instantiation rule shapes: type argument, the two sigils, named measure (an identifier followed by the descent sigil), explicit named form (an identifier, an equals, an expression), and the tail atom. The engine classifies the named forms by identifier — a size or cost name takes its own reserved variant; any other name takes the generic explicit-instantiation variant. The \"declines the reserved residents by name\" clause of the overview is therefore literal: the decline variant is selected by the resident's name, and the diagnostic quotes the resident text.")
                                            BaseInline))
                                       (ConsBlock (ProseBlock
                                            (ConsInline (Txt
                                                 "Second, the unmarked-reference error carries the suggested marked spelling")
                                              (ConsInlineGlued (Bold
                                                   (ConsInline (Txt "as a field")
                                                     BaseInline))
                                                (ConsInline (Txt
                                                     ", not as message text assembled at the diagnostic site. The did-you-mean is part of the finding's data — and that is what lets the diagnostic quality bar of the edge cases (")
                                                  (ConsInlineGlued (XRef anchor_rs_edge)
                                                    (ConsInline (Txt ") be a testable contract.")
                                                      BaseInline))))))
                                         BaseBlock))))))))
                        (ConsSection (MkSection
                             anchor_rs_staging
