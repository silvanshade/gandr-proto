{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "gandr",
  "scopeName": "source.gandr",
  "patterns": [
    {
      "include": "#block-comments"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "comment": "documentation comments",
          "name": "comment.line.documentation.rust",
          "match": "(///).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.rust"
            }
          }
        },
        {
          "comment": "line comments",
          "name": "comment.line.double-slash.rust",
          "match": "(//).*$",
          "captures": {
            "1": {
              "name": "punctuation.definition.comment.rust"
            }
          }
        }
      ]
    },
    "block-comments": {
      "patterns": [
        {
          "comment": "empty block comments",
          "name": "comment.block.rust",
          "match": "/\\*\\*/"
        },
        {
          "comment": "block documentation comments",
          "name": "comment.block.documentation.rust",
          "begin": "/\\*\\*",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#block-comments"
            }
          ]
        },
        {
          "comment": "block comments",
          "name": "comment.block.rust",
          "begin": "/\\*(?!\\*)",
          "end": "\\*/",
          "patterns": [
            {
              "include": "#block-comments"
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "comment": "case",
          "name": "keyword.control.gandr",
          "match": "\\b(case)\\b"
        },
        {
          "comment": "codata",
          "name": "keyword.declaration.codata.gandr storage.type.gandr",
          "match": "\\b(codata)\\b"
        },
        {
          "comment": "data",
          "name": "keyword.declaration.data.gandr storage.type.gandr",
          "match": "\\b(data)\\b"
        },
        {
          "comment": "def",
          "name": "keyword.other.def.gandr",
          "match": "\\b(def)\\b"
        },
        {
          "comment": "let",
          "name": "keyword.other.rust storage.type.rust",
          "match": "\\b(let)\\b"
        },
        {
          "comment": "ret",
          "name": "keyword.control.gandr",
          "match": "\\b(ret)\\b"
        },
        {
          "comment": "sign",
          "name": "storage.type.gandr",
          "match": "\\b(sign)\\b"
        },
        {
          "comment": "val",
          "name": "keyword.other.gandr storage.type.rust",
          "match": "\\b(val)\\b"
        },
        {
          "comment": "-F",
          "name": "entity.name.type.primitive.gandr",
          "match": "-?\\b(F)\\b"
        },
        {
          "comment": "+U",
          "name": "entity.name.type.primitive.gandr",
          "match": "\\+?\\b(U)\\b"
        },
        {
          "comment": "Type",
          "name": "entity.name.type.primitive.gandr",
          "match": "\\b(Type)\\b"
        }
      ]
    }
  }
}
